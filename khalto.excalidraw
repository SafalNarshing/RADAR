    {
      "id": "M7mqzm6SCzalncBmkiuE2",
      "type": "text",
      "x": 3710.950740885378,
      "y": 213.78428756613943,
      "width": 1303.0182733040251,
      "height": 912.3112911644045,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03l",
      "roundness": null,
      "seed": 1115037001,
      "version": 1447,
      "versionNonce": 942514087,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783672039564,
      "link": null,
      "locked": false,
      "text": "CCTV Streaming, detecting\nDashcam detection and update on maps and app\n(autoreporting)\nGovernment vehicle dashcam then update on app\n(auto reporting)\nRewards as citizens reports get fixed\nDashboard + priority \nProgress tracking of report sent\nRerouting based on potholes on the maps\nfor reporting - does damage classification\n(potholes, road damage)\nB2G (Sell to government where citzens gets\nrewards)\n",
      "fontSize": 52.13207378082311,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CCTV Streaming, detecting\nDashcam detection and update on maps and app (autoreporting)\nGovernment vehicle dashcam then update on app (auto reporting)\nRewards as citizens reports get fixed\nDashboard + priority \nProgress tracking of report sent\nRerouting based on potholes on the maps\nfor reporting - does damage classification (potholes, road damage)\nB2G (Sell to government where citzens gets rewards)\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
