      "isDeleted": false,
      "boundElements": [],
      "updated": 1783660711023,
      "link": null,
      "locked": false,
      "text": "Frontend: Flutter-Mobile Side\nBackend: NodeJs + Express (Handles uploads, all storage connections)\nDatabase: Supabase \nMaps: Leaflet\n",
      "fontSize": 41.24455134163126,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frontend: Flutter-Mobile Side\nBackend: NodeJs + Express (Handles uploads, all storage connections)\nDatabase: Supabase \nMaps: Leaflet\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
